{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-pod health for rtpbridge. Designed to surface the accept_answer wedge: a single pod whose WebRTC negotiations get stuck while siblings stay healthy. Wedge detection panels light up only after the telemetry commit (11e41e8) is deployed; the log panels work against current prod.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Wedge detection (requires 11e41e8+)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "Primary wedge signal. Each increment = one WebRTC endpoint that stayed in Connecting past 15s. Any pod breaking away from the pack is the one to drain and pull logs from.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "stuck endpoints / sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_webrtc_connecting_stuck_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "WebRTC connecting stuck — per pod (rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "Total stuck endpoints over the dashboard time range, per pod. Sorted descending — the bad pod sits at the top.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "topk(20, sum by (pod) (increase(rtpbridge_webrtc_connecting_stuck_total{pod=~\"$pod\"}[$__range])))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stuck endpoints in range",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "panels": [],
      "title": "Corroborating media-path signals",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "str0m handle_receive rejections (parse / auth / DTLS). A wedged pod with broken DTLS will sustain a nonzero rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "errors / sec",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_webrtc_packet_errors_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "WebRTC packet errors — per pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "SRTP auth/replay failures.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "errors / sec",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_srtp_errors_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "SRTP errors — per pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "Packets routed between endpoints. A pod that's creating sessions normally but routing near-zero packets is wedged — the smoking gun for accept_answer no-op.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "packets / sec",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_packets_routed_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Packets routed — per pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "description": "Packets routed per active session. A wedged pod shows sessions piling up while this ratio collapses toward zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "pps / session",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_packets_routed_total{pod=~\"$pod\"}[5m])) / clamp_min(sum by (pod) (rtpbridge_sessions_active{pod=~\"$pod\"}), 1)",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Packets-per-active-session — per pod",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 102,
      "panels": [],
      "title": "Capacity / volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 28 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "rtpbridge_sessions_active{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active sessions",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 28 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "rtpbridge_endpoints_active{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active endpoints",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 28 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(rtpbridge_sessions_total{pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Session creation rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 103,
      "panels": [],
      "title": "Log signals (works on current prod)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "description": "Endpoint media timeouts — the only wedge-adjacent signal available pre-11e41e8. Pod with anomalously high count is the suspect.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "timeouts",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (count_over_time({service_name=\"rtpbridge\"} | pod=~\"$pod\" |~ \"endpoint media timeout\" [$__interval]))",
          "legendFormat": "{{pod}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "\"endpoint media timeout\" warns — per pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "description": "Connecting-watchdog warns from 11e41e8. Will be empty until that build is in prod.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "watchdog warns",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_ds}" },
          "editorMode": "code",
          "expr": "sum by (pod) (count_over_time({service_name=\"rtpbridge\"} | pod=~\"$pod\" |~ \"WebRTC negotiation stuck past watchdog threshold\" [$__interval]))",
          "legendFormat": "{{pod}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "\"connecting stuck past watchdog\" warns — per pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${loki_ds}" },
      "description": "Most recent watchdog + media-timeout warns. Drill-down point: click a row to jump into the pod's log stream.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "id": 12,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${loki_ds}" },
          "editorMode": "code",
          "expr": "{service_name=\"rtpbridge\"} | pod=~\"$pod\" |~ \"(endpoint media timeout|WebRTC negotiation stuck past watchdog threshold|accept_answer)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent wedge-relevant log lines",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["rtpbridge", "media", "webrtc"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "prom_ds",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "Loki", "value": "Loki" },
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "loki_ds",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${prom_ds}" },
        "definition": "label_values(rtpbridge_sessions_active, pod)",
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "query": "label_values(rtpbridge_sessions_active, pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "rtpbridge — per-pod health",
  "uid": "rtpbridge-pod-health",
  "version": 1,
  "weekStart": ""
}
